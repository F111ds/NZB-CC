<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFEDE6" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <!-- NZB-CC: HAL's warm dark-red glass -->
            <gradient android:angle="270" android:startColor="#C7461610" android:endColor="#B81C0808" />
            <stroke android:width="1dp" android:color="#29FFFFFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</selector>
