# --- Secrets: never commit ---
# SABnzbd / indexer / Kodi / media server keys
nzb_manager_config.json
# Mobile companion pairing code, alert settings (ntfy token) and saved searches
mobile_access_key.txt
mobile_settings.json
# Half-written config/cache files
*.tmp

# --- Logs, caches and per-machine state ---
mobile_server.log*
nzb_caps_cache.json
nzb_daily_stats.json
media_inspector_cache.json
drive_history.json

# --- Python ---
__pycache__/
*.py[cod]

# Review screenshots
screenshots/

# Local backup copies (e.g. mobile_server.py.before-restyle)
*.before-*

# System Command Center: per-machine settings and window position
system_center_config.json
